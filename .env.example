# Copy this file to .env and fill in real values. Never commit .env.

# Which settings module to load: config.settings.development | staging | production | test
DJANGO_SETTINGS_MODULE=config.settings.development

# Core Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://ederi:ederi@localhost:5432/ederi

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Email (console backend in dev — prints emails to stdout)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@ederi.app
FRONTEND_BASE_URL=http://localhost:8000

# AI (placeholder — not used until the ai module is implemented)
LLM_API_KEY=
